{
  "name": "my-cv",
  "version": "2.0.0",
  "private": true,
  "description": "Maurizio Rendon CV-app",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate && node scripts/build-headers.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:a11y": "playwright test",
    "lighthouse": "npx --yes @lhci/cli@0.16.0 autorun",
    "audit:check": "node scripts/audit.mjs",
    "visits:snapshot": "jiti scripts/visits-snapshot.ts",
    "pdf": "jiti scripts/pdf/generate.ts && scripts/pdf/check-privacy.sh public/Resume-Maurizio-Rendon-en.pdf && scripts/pdf/check-privacy.sh public/Resume-Maurizio-Rendon-es.pdf"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/space-grotesk": "^5.2.0",
    "@iconify-json/lucide": "^1.2.150",
    "@netlify/blobs": "11.1.7",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/i18n": "^10.6.0",
    "chart.js": "^4.6.1",
    "chartjs-chart-geo": "^4.3.6",
    "chartjs-chart-matrix": "^3.1.0",
    "d3-geo": "^3.1.1",
    "nuxt": "^4.6.2",
    "tailwindcss": "^4",
    "vue-chartjs": "^5.3.4",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@nuxt/test-utils": "4.3.4",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "4.1.12",
    "@vue/test-utils": "2.5.1",
    "happy-dom": "21.0.4",
    "pdf-lib": "1.17.1",
    "playwright-core": "1.64.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.3"
  }
}
