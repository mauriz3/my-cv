/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'

# Informe de visitas (JSON prerrenderizado sin extensión).
/api/visits/*
  Content-Type: application/json; charset=utf-8

# Assets de Nuxt con hash en el nombre: caché de un año. `:file` es un solo segmento,
# así no entra `/_nuxt/builds/latest.json` (sin hash; avisa de despliegues nuevos).
/_nuxt/:file
  Cache-Control: public, max-age=31536000, immutable
