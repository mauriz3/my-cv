# Optional. Docker starts without this file; Compose forwards only GEO_COUNTRY and fixes PORT=8080.
# Use only your own values. Never commit .env or service-account keys.

# Netlify Functions / local snapshot script ONLY; never forwarded into Docker. Visits stays sample.
GA_PROPERTY_ID=
GA_SERVICE_ACCOUNT_JSON=
# Local dev ONLY. Never set for generate (real data must not enter the static fallback).
VISITS_SNAPSHOT_FILE=

# Static server CLI only (Compose fixes PORT=8080). Blank country = unknown in Docker.
PORT=8080
GEO_COUNTRY=

# Nuxt/header build ONLY. Docker fixes these internally; runtime values do not change generated files.
CONTEXT=
DEPLOY_PRIME_URL=
# Optional browser executable for PDF/OG generation outside Docker.
CHROME_PATH=
# CI/audit tooling only (not needed to run Docker).
CI=
LHCI_CONSENT=
# GitHub Actions deploy step ONLY. Set your own secrets in GitHub, not in Docker.
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
